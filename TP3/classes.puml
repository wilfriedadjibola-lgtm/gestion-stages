@startuml
skinparam dpi 150
skinparam shadowing false
hide circle
skinparam classAttributeIconSize 0
class Utilisateur {
 id : INT <<PK>>
 email : VARCHAR(100) <<UNIQUE>>
 mot_de_passe_hash : VARCHAR(255)
 role : ENUM
 nom : VARCHAR(60)
 prenom : VARCHAR(60)
 actif : BOOLEAN
}
class Etudiant {
 id : INT <<PK>>
 numero_etudiant : VARCHAR(20) <<UNIQUE>>
 filiere : VARCHAR(60)
}
class Encadreur {
 id : INT <<PK>>
 grade : VARCHAR(60)
}
class Entreprise {
 id : INT <<PK>>
 nom : VARCHAR(80)
 ville : VARCHAR(60)
 contact : VARCHAR(100)
}
class DemandeStage {
 id : INT <<PK>>
 statut : ENUM
 motif_refus : VARCHAR(255)
 date_depot : DATETIME
 date_decision : DATETIME
}
class Historique {
 id : INT <<PK>>
 ancien_statut : ENUM
 nouveau_statut : ENUM
 motif : VARCHAR(255)
 date_evenement : DATETIME
}
Utilisateur "1" -- "0..1" Etudiant : possède
Utilisateur "1" -- "0..1" Encadreur : possède
Etudiant "1" -- "0..*" DemandeStage : dépose
Entreprise "1" -- "0..*" DemandeStage : accueille
Encadreur "1" -- "0..*" DemandeStage : encadre
DemandeStage "1" -- "0..*" Historique : journalise
Utilisateur "1" -- "0..*" Historique : signe
@enduml
